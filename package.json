    "regression:small-village": "tsx src/small-village-regression.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
